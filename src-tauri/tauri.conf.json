{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipMark",
  "version": "0.1.0",
  "identifier": "com.einere.clipmark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ClipMark",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "contentTypes": [
          "net.daringfireball.markdown"
        ],
        "mimeType": "text/markdown",
        "exportedType": {
          "identifier": "net.daringfireball.markdown",
          "conformsTo": [
            "public.plain-text"
          ]
        },
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
